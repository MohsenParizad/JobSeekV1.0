# Copy this file to .env and fill in real values. Never commit .env.

# Required for real (non-mock) evidence extraction.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model used for structured extraction / generation.
ANTHROPIC_MODEL=claude-sonnet-5

# SQLite by default. Point this at a postgresql:// URL from V0.5 onward.
DATABASE_URL=sqlite:///./data/jobseek.db

# Where uploaded CVs / references are stored on disk before/after parsing.
DOCUMENT_STORAGE_DIR=./data/uploads

# Job provider keys (added in V0.4, unused for now).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
